{
  "name": "polipan-web",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o ../api/gen/schema.d.ts",
    "test:e2e": "playwright test",
    "build:check": "POLIPAN_WEB_OUT=dist-check vite build --emptyOutDir",
    "check:parity": "node scripts/check-parity.mjs",
    "check:budget": "node scripts/check-budget.mjs dist-check",
    "test:built": "playwright test --project=built",
    "test:visual": "playwright test visual.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "20.19.39",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4"
  }
}
