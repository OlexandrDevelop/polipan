 "rules": {
  "text-pairs": [
   "text",
   "muted",
   "log-time",
   "primary",
   "amber",
   "cyan",
   "success",
   "warning",
   "danger",
   "info"
  ],
  "control-pairs": [
   "border-strong",
   "chart[0..5]"
  ],
  "glow-never-carries-meaning": "Glow, scanlines and curvature are decoration only. No pair is measured with glow."
 },
 "space": {
  "1": "4px",
  "2": "8px",
  "3": "12px",
  "4": "16px",
  "5": "24px",
  "6": "32px",
  "7": "48px",
  "cell": "1ch (one mono column)",
  "row": "1lh"
 },
 "radius": {
  "none": "0",
  "sm": "2px",
  "md": "2px",
  "lg": "4px",
  "full": "9999px",
  "$note": "Panels and buttons use 0. md and lg exist so old names still resolve. full is for the live dot only."
 },
 "border": {
  "width": "1px",
  "width-focus": "2px",
  "style": "solid",
  "panel": "1px solid var(--color-border-strong)",
  "divider": "1px solid var(--color-border)",
  "dashed": "1px dashed var(--color-border-strong)"
 },
 "font": {
  "sans": "Inter Variable, system-ui, sans-serif (self-hosted woff2, Latin only, long text only)",
  "mono": "JetBrains Mono Variable, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace (self-hosted woff2, Latin, weights 400 500 700)",
  "ui-font": "mono",
  "ligatures": "off for logs, on for labels only if the build wants; default off",
  "scale": {
   "xs": "12/16",
   "sm": "13/20",
   "base": "14/22",
   "lg": "16/24",
   "xl": "20/28",
   "2xl": "28/36"
  },
  "scale-phone": {
   "xs": "12/16",
   "sm": "14/20",
   "base": "16/24",
   "lg": "18/28",
   "xl": "22/30",
   "2xl": "28/36",
   "$note": "Inputs are 16px on phone to stop zoom on focus."
  },
  "weights": [
   400,
   500,
   700
  ],
  "tracking-caps": "0.06em",
  "tabular-nums": "always on in tables, counters, logs (font-variant-numeric: tabular-nums)",
  "budget": "JetBrains Mono Variable Latin woff2 about 40 KB + Inter Variable Latin about 48 KB, total <= 120 KB (REQ-UI-029)"
 },
 "shadow": {
  "none": "none",
  "popover": "0 8px 24px rgb(0 0 0 / .45)",
  "popover-light": "0 6px 20px rgb(0 0 0 / .16)",
  "$note": "Layers are shown by 1px borders, not by shadows. Shadow is only for the palette and menus."
 },
 "glow": {
  "$note": "Only on focus, the live dot and the selected row accent. Off in light theme and in Calm mode. Never on text smaller than 16px.",
  "focus": "0 0 0 1px var(--color-primary), 0 0 12px color-mix(in srgb, var(--color-primary) 45%, transparent)",
  "live": "0 0 6px color-mix(in srgb, var(--color-success) 70%, transparent)",
  "text": "0 0 8px color-mix(in srgb, var(--color-primary) 40%, transparent)",
  "effects-switch-default": "off"
 },
 "effects": {
  "scanlines": {
   "default": "off",
   "opacity": 0.06,
   "pitch": "3px",
   "layer": "fixed overlay, pointer-events none, aria-hidden, mix only transform-free CSS gradient",
   "max-opacity": 0.08
  },
  "curvature": {
   "default": "off",
   "note": "Only a vignette and 2px inner radius on the app frame. No warp of text. Disabled under 1024px, prefers-contrast and Calm mode."
  },
  "glow": {
   "default": "off"
  }
 },
 "motion": {
  "instant": "0ms",
  "fast": "120ms",
  "base": "200ms",
  "slow": "320ms",
  "easing": "cubic-bezier(.2,.8,.2,1)",
  "easing-linear": "linear (only for the packet flow and the cursor blink)",
  "properties": "transform and opacity only (color and background-color allowed for 120ms hover)",
  "cursor-blink": "1060ms steps(1), only on focus, max 10 blinks then stays solid",
  "typewriter": "max 40 chars per frame, never delays real data by more than 1 frame",
  "boot": "max 600ms, once per session, any key or click skips",
  "row-flash": "320ms opacity of an overlay, one-shot",
  "counter": "200ms, number roll by transform, final value is in the DOM text at once",
  "packet": "1600ms linear loop per packet, translateX, 3 to 6 packets",
  "reduced": "With prefers-reduced-motion: reduce or Calm mode: all durations 0ms, no blink, no packets (static arrows and numbers), no boot, no typewriter, no flash (a static marker stays 2s)."
 },
 "breakpoints": {
  "phone": "0-639",
  "tablet": "640-1023",
  "laptop": "1024-1535",
  "large": "1536+"
 },
 "touch": {
  "min-target": "44px",
  "desktop-min-target": "32px",
  "row-height": {
   "phone": "48px",
   "tablet": "40px",
   "laptop": "28px (1.75 lines)",
   "compact": "22px"
  }
 },
 "layout": {
  "statusbar-height": "28px",
  "statusbar-height-phone": "40px",
  "cmdline-height": "36px",
  "cmdline-height-phone": "48px",
  "sidebar": "232px",
  "rail": "64px",
  "content-max-large": "1600px"
 },
 "z": {
  "base": 0,
  "sticky": 10,
  "drawer": 20,
  "dialog": 30,
  "toast": 40,
  "tooltip": 50,
  "scanlines": 60
 }
}